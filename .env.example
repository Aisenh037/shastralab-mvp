# Neon Postgres pooled connection string (postgresql://...-pooler.../db?sslmode=require)
DATABASE_URL=""
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Optional second key from another Google account - auto-rotated on 429
GEMINI_API_KEY_FALLBACK=""
# Model is env-swappable; flash chosen for live-demo latency
GEMINI_MODEL="gemini-3.6-flash"
# Session-signing secret (any long random string)
AUTH_SECRET=""
